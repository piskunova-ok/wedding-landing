# Скопируйте в файл .env (секреты — только здесь, НЕ во frontend-коде)
PORT=3000

# Supabase (облачная БД для RSVP). Если не заданы — заявки хранятся в data/rsvp.json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Пароль для страницы просмотра заявок /admin.html (по умолчанию anna-mikhail-2026)
ADMIN_SECRET=придумайте-свой-пароль

# --- Деплой на Netlify ---
# server.js на Netlify НЕ запускается (статический хостинг).
# Вместо него работает netlify/functions/rsvp.js → /.netlify/functions/rsvp
# Задайте в Netlify Dashboard → Site settings → Environment variables:
#   SUPABASE_URL, SUPABASE_SERVICE_KEY (обязательно — хранилище заявок),
#   ADMIN_SECRET (обязательно — свой пароль),
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (необязательно — уведомления).
# Таблица БД: выполнить supabase.sql в Supabase → SQL Editor.
# Служебные файлы (server.js, data/, supabase.sql) закрыты от публики через netlify.toml.

# Уведомления организаторам (best-effort)
RSVP_NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
